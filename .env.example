# Defence Agent runtime settings.
# Copy to .env for local development. Do not commit real secrets.

COHERE_API_KEY=
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_EMBED_MODEL=embed-v4.0
COHERE_RERANK_MODEL=rerank-v4.0-pro
COHERE_EMBED_OUTPUT_DIMENSION=1536
COHERE_EMBED_PAGE_BATCH_SIZE=1
COHERE_EMBED_PAGE_BATCH_MAX_BYTES=6000000
# Local pacing for Cohere calls. Use 0 for live evals on a personal key where
# budget/token monitoring is the limiting factor.
COHERE_REQUESTS_PER_MINUTE=0
COHERE_MAX_RETRIES=6
COHERE_RETRY_MAX_WAIT_SECONDS=90
COHERE_TIMEOUT_SECONDS=60
# Optional. Only used when the configured Chat model supports thinking blocks.
# Leave unset for Cohere's model default behavior.
COHERE_THINKING_TOKEN_BUDGET=

DEFENCE_AGENT_DATA_DIR=./defence_agent/data
DEFENCE_AGENT_CORPUS_DIR=./defence_agent/data/corpus
DEFENCE_AGENT_PARSER_BACKEND=local
DEFENCE_AGENT_RETRIEVAL_MODE=hybrid
DEFENCE_AGENT_CHUNK_STRATEGY=page
# Optional live eval/script route controls. UI controls override these per run.
DEFENCE_AGENT_RUN_MODE=reviewed_agent
DEFENCE_AGENT_ACCURACY_PRIORITY=4
DEFENCE_AGENT_LATENCY_PRIORITY=2

# Optional Compass parser integration. Compass requires a hosted Parser/API service.
COMPASS_PARSER_URL=
COMPASS_INDEX_URL=
COMPASS_BEARER_TOKEN=

DEFTECH_ADK_PERSONA=clearance_unclassified
DEFTECH_ADK_MODEL=cohere/command-a-03-2025
# Reviewer agent model. Defaults to Cohere Command A Reasoning for citation review.
DEFTECH_ADK_CRITIC_MODEL=command-a-reasoning-08-2025
DEFTECH_ADK_CRITIC_THRESHOLD=0.8
DEFTECH_ADK_CRITIC_MAX_CITATIONS=8
DEFTECH_ADK_TIMEOUT_SECONDS=45
ADK_PORT=8502
