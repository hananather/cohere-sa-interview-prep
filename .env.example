# Defence Agent runtime settings.
# Copy to .env for local development. Do not commit real secrets.

COHERE_API_KEY=
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_EMBED_MODEL=embed-v4.0
COHERE_RERANK_MODEL=rerank-v3.5
COHERE_EMBED_OUTPUT_DIMENSION=1024
USE_MOCK_COHERE=true

DATABASE_URL=sqlite:///./defence_agent/data/defence_agent.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=defence_agent_chunks
TRACE_JSONL_PATH=./defence_agent/data/traces.jsonl
GENERATED_CORPUS_DIR=./defence_agent/data/corpus
MAX_AGENT_STEPS=6
REQUEST_TIMEOUT_SECONDS=30
