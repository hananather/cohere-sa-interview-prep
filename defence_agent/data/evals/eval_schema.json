{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "suite",
    "cases"
  ],
  "properties": {
    "suite": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "query_id",
          "user_query",
          "task_type",
          "topic",
          "capability_tags",
          "complexity_level",
          "complexity_score",
          "complexity_dimensions",
          "user_context",
          "expected_route",
          "expected_tools",
          "expected_answer_behavior",
          "expected_refusal",
          "citation_required"
        ]
      }
    }
  }
}
